# Server-only PostgreSQL connection. A Supabase project can use its direct
# PostgreSQL connection string here; never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:replace-with-password@db.example.supabase.co:5432/postgres
# Set false only for a trusted local PostgreSQL instance without TLS.
DATABASE_SSL=true

# Public origin used to reject cross-site state-changing requests. For local
# development with the default script, use http://localhost:4028.
APP_ORIGIN=http://localhost:4028

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=replace-with-a-long-random-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=smartriver.auth@gmail.com
SMTP_PASS=replace-with-gmail-app-password

# Leave empty when the Raspberry Pi pushes telemetry to POST /api/device.
# Set only when using the legacy pull integration from an external HTTP endpoint.
SMART_RIVER_MONITORING_URL=
# Server-only shared device credential. Generate at least 32 random bytes and
# configure the same value as RIVERWATCH_DEVICE_TOKEN on the Raspberry Pi.
SMART_RIVER_MONITORING_TOKEN=
SMART_RIVER_SOURCE_ID=smart-river-hardware
SMART_RIVER_DEVICE_STALE_SECONDS=30
SMART_RIVER_IMAGE_MAX_BYTES=2000000

# Server-only OpenAI configuration for RiverWatch AI. Never expose this key as
# NEXT_PUBLIC_* or commit a real value.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
