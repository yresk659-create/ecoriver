[Unit]
Description=RiverWatch HTTPS telemetry bridge
Wants=network-online.target
After=network-online.target ecoriver-controller.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/EcoRiver
EnvironmentFile=/home/pi/EcoRiver/device/riverwatch-bridge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/EcoRiver/.venv/bin/python3 /home/pi/EcoRiver/device/riverwatch_bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target