[Unit]
Description=EcoRiver controller (ESP32 UART, camera, and AI)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/EcoRiver
EnvironmentFile=/home/pi/EcoRiver/device/riverwatch-bridge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/EcoRiver/.venv/bin/python3 "/home/pi/EcoRiver/device/final v3.2.py"
Restart=on-failure
RestartSec=5
SupplementaryGroups=dialout video

[Install]
WantedBy=multi-user.target