RIVERWATCH_ORIGIN=https://smart-river-lilac.vercel.app
RIVERWATCH_DEVICE_ID=smart-river-hardware
RIVERWATCH_DEVICE_TOKEN=ganti-dengan-token-acak-yang-sama-dengan-vercel
RIVERWATCH_HEARTBEAT_SECONDS=5
RIVERWATCH_BRIDGE_PORT=5050
RIVERWATCH_IMAGE_MAX_BYTES=2000000
SMART_RIVER_LOCAL_STATUS_URL=http://127.0.0.1:5000/status
# Dipakai oleh final v3.2.py. UART GPIO Pi dan USB ESP32/COM3 sama-sama
# memakai 115200 baud pada firmware saat ini.
SMART_RIVER_SERIAL_PORT=/dev/serial0
SMART_RIVER_SERIAL_BAUD=115200
SMART_RIVER_SERIAL_TIMEOUT=0.1
SMART_RIVER_MODEL_PATH=/home/pi/SmartRiver/device/best.onnx
SMART_RIVER_CAMERA_INDEX=0
SMART_RIVER_SHOW_PREVIEW=0
# Safety first: 0 keeps motors/pump/conveyor off while data and AI monitoring
# still run. Set to 1 only after the bench tests in device/README.md pass.
SMART_RIVER_AUTONOMOUS=0
SMART_RIVER_SAFE_IDLE_INTERVAL=2.0
SMART_RIVER_ESP32_STARTUP_GRACE_SECONDS=15
SMART_RIVER_ESP32_STALE_SECONDS=8
SMART_RIVER_UPLOAD_INTERVAL=1.0
SMART_RIVER_IMAGE_INTERVAL=2.0
